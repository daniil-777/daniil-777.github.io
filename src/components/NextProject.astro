---
/** The "Next project" banner at the foot of a project page. */
import { Image } from 'astro:assets';
import { projectCover, projectHref, type Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const cover = projectCover(project);
---

<nav class="wrap" aria-label="Next project">
  <a class="next" href={projectHref(project)}>
    <span class="next__text">
      <span class="next__label">Next project</span>
      <strong>{project.data.title}</strong>
      <span class="next__tagline">{project.data.tagline}</span>
    </span>
    {
      cover && (
        <span class:list={['next__media', { 'next__media--paper': cover.fit === 'contain' }]}>
          <Image src={cover.image} alt="" widths={[480, 720, 960]} sizes="(min-width: 860px) 360px, (min-width: 700px) 38vw, 92vw" loading="lazy" />
        </span>
      )
    }
  </a>
</nav>

<style>
  nav {
    margin-top: clamp(64px, 9vw, 120px);
  }

  .next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, min(360px, 42%));
    align-items: center;
    gap: 24px clamp(24px, 4vw, 56px);
    padding: clamp(24px, 3.4vw, 44px);
    border-radius: var(--r-xl);
    background: var(--tile);
    color: var(--text);
  }

  .next:hover {
    text-decoration: none;
  }

  .next__text {
    display: grid;
    gap: 6px;
  }

  .next__label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }

  .next strong {
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .next__tagline {
    max-width: 36ch;
    font-size: 17px;
    color: var(--text-2);
  }

  .next__media {
    aspect-ratio: 16 / 10;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow-soft);
    transition: transform 0.6s var(--ease);
  }

  .next:hover .next__media {
    transform: scale(1.025);
  }

  .next__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .next__media--paper {
    background: var(--paper);
    padding: 14px;
  }

  .next__media--paper :global(img) {
    object-fit: contain;
    object-position: 50% 50%;
  }

  @media (max-width: 699px) {
    .next {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
