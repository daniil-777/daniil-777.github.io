---
/**
 * A figure or diagram on a light "paper" backing, so that plots with a white
 * background look right in both themes. Clicking it opens the large version
 * in the zoom dialog of the project page (the <dialog> itself is in
 * pages/work/[slug].astro; its script and styles are below).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** URL of the large version shown when zoomed. */
  zoom: string;
  /** Load eagerly. Use for the first image on a page. */
  priority?: boolean;
}

const { src, alt, caption, zoom, priority = false } = Astro.props;
// Size of the large version, so the dialog can lay it out before it has loaded.
const zoomWidth = Math.min(src.width, 2400);
const zoomHeight = Math.round((src.height * zoomWidth) / src.width);
---

<figure class="paper">
  <a href={zoom} data-zoom data-w={zoomWidth} data-h={zoomHeight} aria-label={`View at full size: ${alt}`}>
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1400, 2000]}
      sizes="(min-width: 1240px) 1100px, 92vw"
      loading={priority ? 'eager' : 'lazy'}
    />
  </a>
  {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]');
  const target = dialog?.querySelector<HTMLImageElement>('[data-zoom-image]');
  // Where the figure is shown larger than the screen and panned (see the styles below).
  const pans = window.matchMedia('(max-width: 899px), (pointer: coarse)');

  if (dialog && target) {
    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-zoom]');
      // Leave Cmd/Ctrl-click and middle-click alone: they open the image in a new tab.
      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const { w = '', h = '' } = link.dataset;
      target.width = Number(w);
      target.height = Number(h);
      target.style.setProperty('--w', w);
      target.style.setProperty('--ratio', String(Number(w) / Number(h)));
      target.src = link.href;
      target.alt = link.querySelector('img')?.alt ?? '';
      dialog.showModal();
      dialog.scrollTo(0, 0);
    });
    // Any click closes: the image, the backdrop or the button. Where the figure
    // pans, a tap on it is left alone, so it can be dragged and pinched.
    dialog.addEventListener('click', (event) => {
      if (!pans.matches || event.target !== target) dialog.close();
    });
  }
</script>

<style>
  .paper {
    max-width: 980px;
    margin-inline: auto;
  }

  .paper a {
    display: block;
    padding: clamp(14px, 2.6vw, 36px);
    border-radius: var(--r-lg);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    cursor: zoom-in;
  }

  .paper :global(img) {
    width: 100%;
    max-height: min(78vh, 900px);
    object-fit: contain;
    filter: var(--figure-filter);
  }
</style>

<style is:global>
  .zoom {
    width: 100vw;
    height: 100dvh;
    padding: clamp(12px, 3vw, 40px);
    cursor: zoom-out;
  }

  .zoom[open] {
    display: grid;
  }

  .zoom img {
    /* Auto margins centre the figure, and keep its start in reach when it overflows. */
    margin: auto;
    width: auto;
    max-width: 100%;
    max-height: calc(100dvh - clamp(24px, 6vw, 80px));
    border-radius: var(--r-md);
    background: #fff;
    object-fit: contain;
  }

  /* Two classes, to win over .icon-btn. Dark, so it reads on the backdrop and over a white figure. */
  .zoom .zoom__close {
    position: fixed;
    top: calc(16px + env(safe-area-inset-top));
    right: calc(16px + env(safe-area-inset-right));
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.28);
  }

  .zoom .zoom__close:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  /*
   * On a phone or tablet, fitting the figure to the screen would hardly enlarge
   * it. It is shown up to its real size instead: at least as wide as the screen,
   * or about 80% of its height, whichever is larger, and the dialog scrolls.
   */
  @media (max-width: 899px), (pointer: coarse) {
    .zoom {
      padding: 12px;
      overflow: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }

    .zoom img {
      width: min(var(--w, 2400) * 1px, max(100%, 80dvh * var(--ratio, 1)));
      height: auto;
      max-width: none;
      max-height: none;
      border-radius: var(--r-sm);
      cursor: default;
    }
  }

  /* A phone held sideways is too short for that to enlarge a wide figure: there it may run to 1.6 screens wide. */
  @media (orientation: landscape) and (max-height: 500px) {
    .zoom img {
      width: min(var(--w, 2400) * 1px, max(100%, 80dvh * var(--ratio, 1), min(160vw, 200dvh * var(--ratio, 1))));
    }
  }
</style>
