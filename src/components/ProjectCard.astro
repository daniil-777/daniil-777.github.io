---
import { Image } from 'astro:assets';
import { CATEGORIES } from '../data/taxonomy';
import { projectCover, projectHref, resolveVideos, type Project } from '../lib/projects';
import Icon from './Icon.astro';
import ProjectActions from './ProjectActions.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const cover = projectCover(project);
const videos = resolveVideos(project);
const category = CATEGORIES[data.category];

/** Everything the search box should find this project by. */
const searchText = [data.title, data.tagline, data.summary, data.organisation, data.role, category.label, data.year, ...data.stack]
  .filter(Boolean)
  .join(' ');
---

<article
  class="card"
  data-card
  data-id={project.id}
  data-category={data.category}
  data-topics={JSON.stringify(data.topics)}
  data-text={searchText}
  data-has-video={videos.length > 0 ? '1' : '0'}
  data-preview-scope
  style={`view-transition-name:card-${project.id}`}
>
  <div class:list={['card__media', { 'card__media--paper': cover?.fit === 'contain' }]} data-preview={videos[0]?.preview}>
    {
      cover && (
        <Image
          src={cover.image}
          alt=""
          widths={[240, 400, 640, 960]}
          sizes="(max-width: 339px) 96px, (max-width: 760px) 112px, (max-width: 959px) 180px, 208px"
          data-list-sizes="(max-width: 339px) 96px, (max-width: 760px) 112px, (max-width: 959px) 180px, 208px"
          data-grid-sizes="(min-width: 1240px) 378px, (min-width: 1000px) 31vw, (min-width: 664px) 46vw, 92vw"
          loading="lazy"
        />
      )
    }
    {
      // A single video is announced by its own button below; the badge is for sets.
      videos.length > 1 && (
        <span class="card__badge">
          <Icon name="play" />
          {videos.length}
          <span class="card__badge-word">videos</span>
        </span>
      )
    }
  </div>
  <div class="card__body">
    <p class="card__meta">{category.label} · {data.year}</p>
    <h3 class="card__title">
      <a href={projectHref(project)}>{data.title}</a>
    </h3>
    <p class="card__tagline">{data.tagline}</p>
    <ul class="card__topics">
      {data.topics.slice(0, 3).map((topic) => <li class="chip">{topic}</li>)}
    </ul>
    <div class="card__actions">
      <ProjectActions project={project} />
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .card:hover,
  .card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #000;
    object-position: 50% 0;
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    transition: transform 0.9s var(--ease);
  }

  .card:hover .card__media :global(img) {
    transform: scale(1.03);
  }

  .card__media--paper {
    background: var(--paper);
    padding: 20px;
  }

  .card__media--paper :global(img) {
    object-fit: contain;
    object-position: 50% 50%;
    filter: var(--figure-filter);
  }

  .card__badge {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px 0 8px;
    border-radius: 980px;
    background: rgba(0, 0, 0, 0.62);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .card__badge :global(svg) {
    width: 11px;
    height: 11px;
  }

  .card__body {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    padding: 20px 22px 22px;
    /* The action row below adapts to the width of the card, not of the screen. */
    container-type: inline-size;
  }

  /* Three buttons (video, demo, code) on one line in a narrow card: first tighter, then without the word "Video". */
  @container (max-width: 315px) {
    .card__actions :global(.actions) {
      gap: 6px;
    }

    .card__actions :global(.act) {
      gap: 6px;
      padding: 0 10px 0 9px;
    }
  }

  @container (max-width: 284px) {
    .card__actions :global(.act--video .act__label) {
      display: none;
    }
  }

  /* The narrowest phones (320px): the demo and code buttons are icons as well. */
  @container (max-width: 250px) {
    .card__actions :global(a.act .act__label) {
      display: none;
    }
  }

  .card__actions {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .card__meta {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
    margin-bottom: 6px;
  }

  .card__title {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .card__title a {
    color: var(--text);
  }

  .card__title a:hover {
    text-decoration: none;
  }

  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .card__title a:focus-visible {
    outline: none;
  }

  .card:has(.card__title a:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--accent) 70%, transparent);
    outline-offset: 3px;
  }

  .card__tagline {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .card__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }

  .card__topics .chip {
    height: 26px;
    padding: 0 10px;
    font-size: 12px;
  }

  /* A quiet publication-style list: image, readable record, then its links. */
  :global([data-view='list']) .card {
    grid-template-columns: 208px minmax(0, 1fr);
    grid-template-rows: auto;
    gap: clamp(24px, 3vw, 36px);
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    overflow: visible;
  }

  :global([data-view='list']) .card:hover,
  :global([data-view='list']) .card:focus-within {
    transform: none;
    box-shadow: none;
  }

  :global([data-view='list']) .card__media {
    aspect-ratio: 16 / 10;
    min-height: 0;
    align-self: start;
    margin-top: 3px;
    border-radius: 12px;
  }

  :global([data-view='list']) .card__media--paper { padding: 12px; }

  :global([data-view='list']) .card__body {
    display: block;
    min-width: 0;
    padding: 0;
  }

  :global([data-view='list']) .card__meta {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .025em;
    margin-bottom: 7px;
  }

  :global([data-view='list']) .card__title {
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.3;
    letter-spacing: -.025em;
    text-wrap: pretty;
  }

  :global([data-view='list']) .card__title a:hover { color: var(--link); }

  :global([data-view='list']) .card__tagline {
    max-width: 72ch;
    margin-top: 9px;
    font-size: 15px;
    line-height: 1.6;
  }

  :global([data-view='list']) .card__topics { display: none; }

  :global([data-view='list']) .card__actions {
    max-width: none;
    margin-top: 12px;
    padding: 0;
    border: 0;
  }

  :global([data-view='list']) .card__actions :global(.actions) { gap: 8px 22px; }

  :global([data-view='list']) .card__actions :global(.act) {
    min-height: 34px;
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: var(--link);
    font-size: 13px;
    font-weight: 500;
  }

  :global([data-view='list']) .card__actions :global(.act:hover) {
    background: transparent;
    text-decoration: underline;
    text-underline-offset: .25em;
  }

  :global([data-view='list']) .card__actions :global(.act .act__label) {
    display: inline;
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    clip-path: none;
  }

  :global([data-view='list']) .card__actions :global(.act__time) { color: var(--text-3); }

  @media (pointer: coarse) {
    :global([data-view='list']) .card__actions :global(.act) { min-height: 44px; }
  }

  @media (max-width: 959px) {
    :global([data-view='list']) .card { grid-template-columns: 180px minmax(0, 1fr); gap: 24px; }
  }

  @media (max-width: 760px) {
    :global([data-view='list']) .card {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 18px;
      padding: 24px 0;
    }
    :global([data-view='list']) .card__media { border-radius: 9px; }
    :global([data-view='list']) .card__title { font-size: 18px; }
    :global([data-view='list']) .card__tagline { font-size: 14px; line-height: 1.55; }
    :global([data-view='list']) .card__actions :global(.actions) { gap: 4px 16px; }
    :global([data-view='list']) .card__badge { left: 7px; bottom: 7px; height: 22px; }
    :global([data-view='list']) .card__badge-word { display: none; }
  }

  @media (max-width: 339px) {
    :global([data-view='list']) .card { grid-template-columns: 96px minmax(0, 1fr); gap: 14px; }
  }
</style>
