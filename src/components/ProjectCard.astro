---
import { Image } from 'astro:assets';
import { CATEGORIES } from '../data/taxonomy';
import { projectCover, projectHref, resolveVideos, type Project } from '../lib/projects';
import Icon from './Icon.astro';
import ProjectActions from './ProjectActions.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const cover = projectCover(project);
const videos = resolveVideos(project);
const category = CATEGORIES[data.category];

/** Everything the search box should find this project by. */
const searchText = [data.title, data.tagline, data.summary, data.organisation, data.role, category.label, data.year, ...data.stack]
  .filter(Boolean)
  .join(' ');
---

<article
  class="card"
  data-card
  data-id={project.id}
  data-category={data.category}
  data-topics={JSON.stringify(data.topics)}
  data-text={searchText}
  data-has-video={videos.length > 0 ? '1' : '0'}
  data-preview-scope
  style={`view-transition-name:card-${project.id}`}
>
  <div class:list={['card__media', { 'card__media--paper': cover?.fit === 'contain' }]} data-preview={videos[0]?.preview}>
    {
      cover && (
        <Image
          src={cover.image}
          alt=""
          widths={[400, 640, 960]}
          sizes="(min-width: 1240px) 378px, (min-width: 1000px) 31vw, (min-width: 664px) 46vw, 92vw"
          loading="lazy"
        />
      )
    }
    {
      // A single video is announced by its own button below; the badge is for sets.
      videos.length > 1 && (
        <span class="card__badge">
          <Icon name="play" />
          {videos.length}
          <span class="card__badge-word">videos</span>
        </span>
      )
    }
  </div>
  <div class="card__body">
    <p class="card__meta">{category.label} · {data.year}</p>
    <h3 class="card__title">
      <a href={projectHref(project)}>{data.title}</a>
    </h3>
    <p class="card__tagline">{data.tagline}</p>
    <ul class="card__topics">
      {data.topics.slice(0, 3).map((topic) => <li class="chip">{topic}</li>)}
    </ul>
    <div class="card__actions">
      <ProjectActions project={project} />
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .card:hover,
  .card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #000;
    object-position: 50% 0;
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    transition: transform 0.9s var(--ease);
  }

  .card:hover .card__media :global(img) {
    transform: scale(1.03);
  }

  .card__media--paper {
    background: var(--paper);
    padding: 20px;
  }

  .card__media--paper :global(img) {
    object-fit: contain;
    object-position: 50% 50%;
    filter: var(--figure-filter);
  }

  .card__badge {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px 0 8px;
    border-radius: 980px;
    background: rgba(0, 0, 0, 0.62);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .card__badge :global(svg) {
    width: 11px;
    height: 11px;
  }

  .card__body {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    padding: 20px 22px 22px;
    /* The action row below adapts to the width of the card, not of the screen. */
    container-type: inline-size;
  }

  /* Three buttons (video, demo, code) on one line in a narrow card: first tighter, then without the word "Video". */
  @container (max-width: 315px) {
    .card__actions :global(.actions) {
      gap: 6px;
    }

    .card__actions :global(.act) {
      gap: 6px;
      padding: 0 10px 0 9px;
    }
  }

  @container (max-width: 284px) {
    .card__actions :global(.act--video .act__label) {
      display: none;
    }
  }

  /* The narrowest phones (320px): the demo and code buttons are icons as well. */
  @container (max-width: 250px) {
    .card__actions :global(a.act .act__label) {
      display: none;
    }
  }

  .card__actions {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .card__meta {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
    margin-bottom: 6px;
  }

  .card__title {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .card__title a {
    color: var(--text);
  }

  .card__title a:hover {
    text-decoration: none;
  }

  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .card__title a:focus-visible {
    outline: none;
  }

  .card:has(.card__title a:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--accent) 70%, transparent);
    outline-offset: 3px;
  }

  .card__tagline {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .card__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }

  .card__topics .chip {
    height: 26px;
    padding: 0 10px;
    font-size: 12px;
  }

  /* ------------------------------------------------------------ list view */

  :global([data-view='list']) .card {
    grid-template-columns: clamp(120px, 34vw, 248px) minmax(0, 1fr);
    grid-template-rows: auto;
    border-radius: 20px;
  }

  :global([data-view='list']) .card:hover,
  :global([data-view='list']) .card:focus-within {
    transform: translateY(-2px);
  }

  :global([data-view='list']) .card__media {
    aspect-ratio: auto;
    min-height: 100%;
  }

  :global([data-view='list']) .card__media--paper {
    padding: 12px;
  }

  :global([data-view='list']) .card__media :global(img) {
    position: absolute;
    inset: 0;
  }

  :global([data-view='list']) .card__media--paper :global(img) {
    inset: 12px;
    width: calc(100% - 24px);
    height: calc(100% - 24px);
  }

  /* Text on the left, the action buttons on the right. */
  :global([data-view='list']) .card__body {
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    grid-template-rows: auto auto auto auto;
    align-content: center;
    column-gap: clamp(16px, 3vw, 40px);
    min-height: clamp(96px, 13vw, 156px);
    padding: clamp(14px, 1.8vw, 22px) clamp(16px, 2.2vw, 28px);
  }

  :global([data-view='list']) .card__meta,
  :global([data-view='list']) .card__title,
  :global([data-view='list']) .card__tagline,
  :global([data-view='list']) .card__topics {
    grid-column: 1;
  }

  :global([data-view='list']) .card__tagline {
    margin-top: 6px;
  }

  :global([data-view='list']) .card__topics {
    margin-top: 12px;
  }

  :global([data-view='list']) .card__actions {
    grid-column: 2;
    grid-row: 1 / -1;
    align-self: center;
    max-width: 320px;
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  :global([data-view='list']) .card__actions :global(.actions) {
    justify-content: flex-end;
  }

  /* Up to a portrait tablet the buttons move under the text, which would otherwise be squeezed into a sliver. */
  @media (max-width: 959px) {
    :global([data-view='list']) .card__topics {
      display: none;
    }

    :global([data-view='list']) .card__body {
      grid-template-columns: minmax(0, 1fr);
    }

    :global([data-view='list']) .card__actions {
      grid-column: 1;
      grid-row: auto;
      margin-top: 10px;
    }

    :global([data-view='list']) .card__actions :global(.actions) {
      justify-content: flex-start;
    }
  }

  @media (max-width: 760px) {
    /* On a phone the buttons shrink to their icons. */
    :global([data-view='list']) .card__actions :global(.actions) {
      gap: 6px;
    }

    :global([data-view='list']) .card__actions :global(.act) {
      padding: 0 12px;
    }

    /* A small landscape thumbnail, so a title baked into a poster is not cut mid-word. */
    :global([data-view='list']) .card {
      grid-template-columns: 112px minmax(0, 1fr);
      align-items: start;
    }

    :global([data-view='list']) .card__media {
      aspect-ratio: 16 / 10;
      min-height: 0;
      margin: 14px 0 0 14px;
      border-radius: 10px;
    }

    /* Icons only (the video button keeps its duration), so three fit on one line. */
    :global([data-view='list']) .card__actions :global(.act__label) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    :global([data-view='list']) .card__title {
      font-size: 17px;
    }

    :global([data-view='list']) .card__tagline {
      font-size: 14px;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    :global([data-view='list']) .card__badge {
      left: 8px;
      bottom: 8px;
      height: 22px;
    }

    /* The thumbnail is small: the icon and the count say enough. */
    :global([data-view='list']) .card__badge-word {
      display: none;
    }
  }

  /* The narrowest phones: a smaller thumbnail and no duration, so three buttons still share a line. */
  @media (max-width: 339px) {
    :global([data-view='list']) .card {
      grid-template-columns: 96px minmax(0, 1fr);
    }

    :global([data-view='list']) .card__actions :global(.act__time) {
      display: none;
    }
  }
</style>
