export type IconName = keyof typeof line | keyof typeof solid;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const isSolid = name in solid;
const d = isSolid ? solid[name as keyof typeof solid] : line[name as keyof typeof line];
---

{
  isSolid ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d={d} />
    </svg>
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d={d} />
    </svg>
  )
}
