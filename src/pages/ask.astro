---
/**
 * Questions and answers: every fact in src/content/facts/ on one page. It is
 * where the "Ask AI" links lead without JavaScript, and the page the
 * assistant cites for a fact that no other page states.
 */
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const facts = await Promise.all(
  (await getCollection('facts'))
    .sort((a, b) => a.id.localeCompare(b.id))
    .map(async (fact) => ({ id: fact.id, ...fact.data, Content: (await render(fact)).Content })),
);
/** The entry about the assistant itself closes the page, under the anchor the dialog links to. */
const HOW = 'how-it-works';
const how = facts.find((fact) => fact.id === HOW);
const answered = facts.filter((fact) => !fact.sensitive && fact.id !== HOW);
const declined = facts.filter((fact) => fact.sensitive);
---

<Base title="Questions and answers" description="Questions people ask about Daniil Emtsev, answered from the content of this site.">
  <section class="section">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">Ask AI</p>
        <h1 class="h2">Let’s explore the work.</h1>
        <p class="lead" data-no-translate>The interactive assistant is temporarily paused. Browse the answers below, or get in touch through the contact section.</p>
        <p class="ask__cta">
          <!-- On this page the fallback is the answers below, not the page itself. -->
          <button class="btn btn--primary" type="button" disabled data-chat-paused data-no-translate>Assistant paused</button>
        </p>
        <p class="muted ask__cta" data-no-translate>The answers below remain available.</p>
      </header>

      <div id="answers">
        {
          answered.map(({ id, question, Content }) => (
            <article class="ask__item" id={id}>
              <h2 class="h3">{question}</h2>
              <Content />
            </article>
          ))
        }
      </div>

      <h2 class="eyebrow ask__group">Not on this site</h2>
      {
        declined.map(({ id, question, Content }) => (
          <article class="ask__item" id={id}>
            <h3 class="h3">{question}</h3>
            <Content />
          </article>
        ))
      }

      {
        how && (
          <>
            <h2 class="eyebrow ask__group">How this works</h2>
            <article class="ask__item" id={HOW}>
              <h3 class="h3">{how.question}</h3>
              <how.Content />
            </article>
          </>
        )
      }
    </div>
  </section>
</Base>

<style>
  .ask__cta {
    margin-top: 28px;
  }

  .ask__item {
    max-width: 820px;
    padding-block: 22px;
    border-top: 1px solid var(--line);
    color: var(--text-2);
  }

  .ask__item .h3 {
    margin-bottom: 8px;
    color: var(--text);
  }

  .ask__item :global(:is(p, ul) + :is(p, ul)) {
    margin-top: 10px;
  }

  .ask__item :global(ul) {
    padding-left: 1.2em;
  }

  .ask__item :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .ask__group {
    margin: 56px 0 14px;
  }

  /* A source the assistant cites is easy to find when the page opens at it. */
  .ask__item:target .h3 {
    color: var(--link);
  }
</style>
