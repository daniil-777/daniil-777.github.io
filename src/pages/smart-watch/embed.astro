---
import SmartWatch from '../../components/SmartWatch.astro';
import '../../styles/global.css';
import '@fontsource-variable/inter/wght.css';
---
<!doctype html>
<html lang="en" data-theme="dark" data-no-translate>
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Compact smart watch</title></head>
  <body data-no-translate style="margin:0; min-height:100vh; display:grid; place-content:center; background:#070b0d; color:#e9efec; font-family:Inter,system-ui,sans-serif;">
    <main style="text-align:center; padding:2rem;">
      <p style="font-size:.7rem; letter-spacing:.2em; opacity:.6;">SMART WATCH · COMPACT DEMO</p>
      <SmartWatch id="chronos-embed" compact={true} diameter={380} />
      <p style="max-width:24rem; font-size:.85rem; line-height:1.6; opacity:.65;">Open the watch to explore the companion. All processing stays on this device.</p>
      <a href="/smart-watch/" style="color:#b8d4c8; font-size:.8rem;">Full watch ↗</a>
    </main>
  </body>
</html>
