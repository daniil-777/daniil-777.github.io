{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "demtsev-portfolio",
  "main": "index.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "demtsev.com",
      "custom_domain": true
    },
    {
      "pattern": "www.demtsev.com",
      "custom_domain": true
    }
  ],
  "ratelimits": [{ "name": "RL_SITE", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }],
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "../../build",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "ORIGIN_STATE",
      "id": "e5affd81b17545b6bfbdeb7b4e0e4fba"
    }
  ],
  "vars": {
    "FALLBACK_RELEASE": "projects-list-20261006-v1"
  }
}
